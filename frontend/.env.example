# Frontend environment variables (optional).
# Copy to frontend/.env only if you need to change something.
# These values are PUBLIC (bundled into the browser) — never put secrets here.

# Leave empty to use the built-in dev proxy (/api -> http://127.0.0.1:4000).
# VITE_API_URL="http://localhost:4000/api"

# Where the dev proxy forwards /api requests.
# VITE_API_PROXY_TARGET="http://127.0.0.1:4000"
