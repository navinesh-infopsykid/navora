// Prisma schema for simple-billing-software.
//
// MONEY RULE: every amount is stored as an integer number of PAISE
// (1 rupee = 100 paise). This avoids floating-point rounding errors.
// Example: Rs. 49.50 is stored as 4950.

generator client {
  provider   = "prisma-client-js"
  // "client" = Rust-free Prisma Client. Queries run through the `pg`
  // driver (see src/lib/db.ts), so no query-engine binary is needed.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Supabase: pooled connection (port 6543) used by the running app.
  url       = env("DATABASE_URL")
  // Supabase: direct connection (port 5432) used by migrations.
  directUrl = env("DIRECT_URL")
}

enum DiscountType {
  NONE
  FIXED // rupee amount, stored in paise
  PERCENT // percentage, stored in basis points (12.5% = 1250)
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
  SPLIT // invoice paid with more than one method; see its Payment rows
}

enum StockMovementType {
  ADJUSTMENT // manual increase/decrease from the Stock Adjustment page
  SALE // automatic deduction when an invoice is finalized
}

enum WhatsAppMode {
  MANUAL_LINK // we only generated a wa.me link; delivery is unknown
  CLOUD_API // sent through the official WhatsApp Business Cloud API
}

enum WhatsAppStatus {
  LINK_GENERATED // manual: link opened in the browser, NOT a delivery confirmation
  ACCEPTED // cloud API accepted the message (not yet delivered)
  SENT // webhook: sent from WhatsApp servers
  DELIVERED // webhook: delivered to customer's phone
  READ // webhook: read by customer
  FAILED // API call or delivery failed
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  sku               String?  @unique
  pricePaise        Int
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  // false = the bill-level discount never applies to this item.
  discountAllowed   Boolean  @default(true)
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@index([name])
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  // Normalised digits with country code, e.g. "919876543210". Optional.
  phone     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model Invoice {
  id            Int            @id @default(autoincrement())
  invoiceNumber String         @unique
  customerId    Int
  customer      Customer       @relation(fields: [customerId], references: [id])
  // Snapshots: the invoice keeps the name/phone used at billing time.
  customerName  String
  customerPhone String?
  invoiceDate   DateTime       @default(now())
  subtotalPaise Int
  discountType  DiscountType   @default(NONE)
  // FIXED: paise. PERCENT: basis points (1% = 100). NONE: 0.
  discountValue Int            @default(0)
  discountPaise Int            @default(0)
  totalPaise    Int
  paymentStatus PaymentStatus
  paymentMethod PaymentMethod
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items            InvoiceItem[]
  payments         Payment[]
  stockMovements   StockMovement[]
  whatsAppMessages WhatsAppMessage[]

  @@index([invoiceDate])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([customerName])
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product @relation(fields: [productId], references: [id])
  // Historical snapshots: never change after the invoice is created.
  productName    String
  sku            String?
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int
  // Snapshot: was this line eligible for the bill discount when billed?
  discountAllowed Boolean @default(true)

  @@unique([invoiceId, productId])
}

model Payment {
  id          Int           @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaise Int
  method      PaymentMethod
  paidAt      DateTime      @default(now())
  note        String?

  @@index([invoiceId])
  @@index([paidAt])
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  productId     Int
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  previousStock Int
  change        Int // positive = added, negative = removed
  newStock      Int
  reason        String
  invoiceId     Int?
  invoice       Invoice?          @relation(fields: [invoiceId], references: [id])
  createdAt     DateTime          @default(now())

  // Guarantees an invoice can deduct a given product's stock only ONCE.
  // (PostgreSQL treats NULL invoiceIds as distinct, so manual adjustments are unaffected.)
  @@unique([invoiceId, productId])
  @@index([productId, createdAt])
}

model BusinessSettings {
  id                Int      @id @default(1)
  businessName      String   @default("My Shop")
  businessAddress   String   @default("")
  businessPhone     String   @default("")
  currency          String   @default("INR")
  invoiceFooter     String   @default("Thank you for your business!")
  invoicePrefix     String   @default("INV")
  // Next invoice serial; incremented atomically inside the invoice transaction.
  nextInvoiceNumber Int      @default(1)
  updatedAt         DateTime @updatedAt
}

model WhatsAppMessage {
  id                Int            @id @default(autoincrement())
  invoiceId         Int
  invoice           Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  phone             String
  mode              WhatsAppMode
  status            WhatsAppStatus
  providerMessageId String?        @unique
  error             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  name         String
  // Login with either email or phone (at least one is required by the API).
  email        String?   @unique // stored lowercase
  phone        String?   @unique // digits with country code, e.g. "918270570052"
  // scrypt hash; the plain password is never stored.
  passwordHash String
  // The first account created. Only the owner can add or deactivate users.
  isOwner      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the random token kept in the browser cookie (the token itself is never stored).
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

// A bill parked at the counter ("Hold") to be finished later ("Recall").
// At most 5 at a time. Stock is NOT reserved: it is only deducted when the bill is saved.
model HeldCart {
  id            Int          @id @default(autoincrement())
  customerName  String?
  customerPhone String?
  discountType  DiscountType @default(NONE)
  // FIXED: paise. PERCENT: basis points. Same meaning as Invoice.discountValue.
  discountValue Int          @default(0)
  // [{ "productId": 3, "quantity": 2 }, ...]
  items         Json
  createdByName String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
