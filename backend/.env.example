# ---------------------------------------------------------------
# Backend environment variables.
# Copy this file to "backend/.env" and fill in real values.
# NEVER commit backend/.env — it contains secrets.
# ---------------------------------------------------------------

# --- Database (Supabase) ---------------------------------------
# Supabase dashboard -> Connect (top bar) -> "Session pooler" connection string.
# Use the SAME session-pooler string (port 5432) for both values below.
# Replace [YOUR-PASSWORD] with your database password. If the password has
# special characters (@ # / ? %), URL-encode them (see README).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# Used by Prisma migrations:
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# SSL: "require" (default for remote hosts, encrypts traffic) or "disable"
# (default for localhost). Usually leave this commented out.
# DATABASE_SSL="require"
# Max database connections the app opens (Supabase free tier: keep small).
DATABASE_POOL_SIZE=5

# Optional: a SEPARATE empty database for automated tests.
# Tests wipe all tables in this database. Never point it at real data.
# TEST_DATABASE_URL="postgresql://yourmacusername@localhost:5432/billing_test"

# --- Server -----------------------------------------------------
PORT=4000
# 127.0.0.1 = only this computer can reach the API (recommended: there is no login).
HOST="127.0.0.1"
# Frontend address(es) allowed by CORS, comma separated.
CORS_ORIGIN="http://localhost:5173"
# Timezone used for "today", "this week", "this month" filters.
APP_TIMEZONE="Asia/Kolkata"
# Country code added to 10-digit phone numbers.
DEFAULT_COUNTRY_CODE="91"

# --- WhatsApp Business Cloud API (OPTIONAL) ---------------------
# Leave these empty to use only the manual wa.me sharing flow.
# These are read ONLY by the backend and never sent to the browser.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Approved message template with a DOCUMENT header and two body
# variables: {{1}} = invoice number, {{2}} = total amount.
# Without a template, WhatsApp only allows sending to customers who
# messaged you in the last 24 hours.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Webhook (delivery receipts). Only needed for "Delivered/Read" status.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
